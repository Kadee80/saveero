# Copy this file to .env and fill in your values.
# Never commit .env — it is in .gitignore.

# ── Supabase (backend) ─────────────────────────────────────────────────────────
# Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Settings → API → service_role key (keep secret — backend only)
SUPABASE_SERVICE_ROLE_KEY=

# ── AI (OpenRouter) ────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...

# ── MLS data ───────────────────────────────────────────────────────────────────
# Optional — Perplexity is used as fallback if not set
BRIDGE_SERVER_KEY=

# ── CRM notifications ──────────────────────────────────────────────────────────
# Optional. Webhook fired when a lead enters 'engaged' (clicked a
# Contact-a-partner button). Point this at a Zapier "Catch Hook" URL;
# route the payload to Slack / email / SMS / etc. on the Zapier side.
# Unset → engaged-lead notifications are silently skipped.
ENGAGED_LEAD_WEBHOOK_URL=
# Optional. Public base URL of the deployed app — used to build a deep
# link to the CRM in the notification payload (e.g. https://app.saveero.com).
APP_BASE_URL=

# ── Frontend ───────────────────────────────────────────────────────────────────
# Build output path (default: webapp/dist)
FRONTEND_DIST=webapp/dist
